flowchart TB
    U["Objetivo / Usuário"] --> O["Orquestrador Rust"]
    O --> W["Memória de trabalho"]
    O --> R["Recuperação híbrida"]
    R --> ME["Memória episódica"]
    R --> MS["Memória semântica"]
    R --> MP["Memória procedural"]
    W --> WM["World model: crenças e previsões"]
    R --> WM
    WM --> P["Planner: DAG de subobjetivos"]
    P --> RE["Reasoner: hipóteses e busca"]
    RE --> V{"Verificador e risco"}
    V -->|"baixa confiança"| I["Investigar / recuperar / escalar"]
    I --> R
    V -->|"aprovado"| G["Gateway de ferramentas"]
    G --> T["Ferramentas / simulador / robô"]
    T --> OBS["Observação e resultado"]
    OBS --> O
    OBS --> LOG["Log de eventos e checkpoint"]
    LOG --> C["Consolidação"]
    C --> ME
    C --> MS
    C --> MP
    C --> L["Aprendizado contínuo: replay e skills"]
    L --> P
    L --> WM

    classDef persistent fill:#e8f1ff,stroke:#2563eb,color:#111827;
    classDef decision fill:#fff7db,stroke:#ca8a04,color:#111827;
    class ME,MS,MP,WM,LOG persistent;
    class V decision;
