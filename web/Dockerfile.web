# Multi-stage Dockerfile for Strata React Web Dashboard
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
RUN npm install -g vite

ENV HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=3s --timeout=3s --start-period=3s --retries=10 \
    CMD wget --spider http://localhost:3000 || exit 1

CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "3000"]
